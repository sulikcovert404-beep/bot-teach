APP_ENV=development
APP_NAME=AI Education Platform Iran
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/education
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
PAYMENT_WEBHOOK_SECRET=replace-with-random-payment-webhook-secret
GEMINI_API_KEY=replace-with-gemini-api-key
AI_DEFAULT_MODEL=gemini-2.0-flash
JWT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=
